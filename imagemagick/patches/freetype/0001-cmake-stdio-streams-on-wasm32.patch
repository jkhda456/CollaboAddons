On wasm32 Linux, the portable stdio stream (src/base/ftsystem.c), not the Unix one: that maps font
files with mmap(), which a guest program does not have (the sysroot's <sys/mman.h> declares no
mmap on wasm).

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -462,7 +462,7 @@
 
 if (WIN32)
   list(APPEND BASE_SRCS "builds/windows/ftsystem.c")
-elseif (UNIX)
+elseif (UNIX AND NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "wasm32")
   list(APPEND BASE_SRCS "builds/unix/ftsystem.c")
 else ()
   list(APPEND BASE_SRCS "src/base/ftsystem.c")
