+/*
+  Fonts for the characters a font has no glyph for, as a font on a system with
+  fontconfig falls back to another (Hangul in a Latin font): a list, separated by
+  commas, of type.xml's font names or families, or font files; "none" for none.
+  The image's "type:fallback-font" (-define type:fallback-font=...) if it has
+  one, else the policy "system:fallback-font". A family's member is the one
+  closest to the font's own weight and slant; each font is opened when a
+  character first needs it.
+*/
+#define MaxFallbackFonts  8
+
+typedef struct _FallbackInfo
+{
+  FT_Library
+    library;
+
+  FT_F26Dot6
+    size;
+
+  FT_UInt
+    x_resolution,
+    y_resolution;
+
+  size_t
+    number_fonts;
+
+  char
+    *paths[MaxFallbackFonts];
+
+  FT_Face
+    faces[MaxFallbackFonts];
+
+  MagickBooleanType
+    opened[MaxFallbackFonts];
+} FallbackInfo;
+
+static void AcquireFallbackFonts(const Image *image,const DrawInfo *draw_info,
+  const FT_Face face,FallbackInfo *fallback,ExceptionInfo *exception)
+{
+  char
+    *list,
+    *name,
+    *next;
+
+  const char
+    *value;
+
+  size_t
+    weight;
+
+  StyleType
+    style;
+
+  value=GetImageArtifact(image,"type:fallback-font");
+  if (value == (const char *) NULL)
+    value=GetImageProperty(image,"type:fallback-font",exception);
+  if (value != (const char *) NULL)
+    list=AcquireString(value);
+  else
+    list=GetPolicyValue("system:fallback-font");
+  if (list == (char *) NULL)
+    return;
+  weight=(face->style_flags & FT_STYLE_FLAG_BOLD) != 0 ? 700 : 400;
+  style=(face->style_flags & FT_STYLE_FLAG_ITALIC) != 0 ? ItalicStyle :
+    NormalStyle;
+  for (name=list; (name != (char *) NULL) &&
+       (fallback->number_fonts < MaxFallbackFonts); name=next)
+  {
+    const char
+      *path;
+
+    const TypeInfo
+      *type_info;
+
+    next=strchr(name,',');
+    if (next != (char *) NULL)
+      *next++='\0';
+    StripString(name);
+    if ((*name == '\0') || (LocaleCompare(name,"none") == 0))
+      continue;
+    path=(const char *) NULL;
+    if (IsPathAccessible(name) != MagickFalse)
+      path=name;
+    else
+      {
+        type_info=GetTypeInfoByFamily(name,style,AnyStretch,weight,exception);
+        if ((type_info == (const TypeInfo *) NULL) ||
+            (type_info->family == (char *) NULL) ||
+            (LocaleCompare(type_info->family,name) != 0))
+          type_info=GetTypeInfo(name,exception);
+        if ((type_info != (const TypeInfo *) NULL) &&
+            ((LocaleCompare(type_info->name,name) == 0) ||
+             ((type_info->family != (char *) NULL) &&
+              (LocaleCompare(type_info->family,name) == 0))))
+          path=type_info->glyphs;
+      }
+    if ((path == (const char *) NULL) ||
+        ((draw_info->font != (char *) NULL) &&
+         (LocaleCompare(path,draw_info->font) == 0)))
+      continue;
+    fallback->paths[fallback->number_fonts]=ConstantString(path);
+    fallback->faces[fallback->number_fonts]=(FT_Face) NULL;
+    fallback->opened[fallback->number_fonts]=MagickFalse;
+    fallback->number_fonts++;
+  }
+  list=DestroyString(list);
+}
+
+static void DestroyFallbackFonts(FallbackInfo *fallback)
+{
+  size_t
+    i;
+
+  for (i=0; i < fallback->number_fonts; i++)
+  {
+    if (fallback->faces[i] != (FT_Face) NULL)
+      (void) FT_Done_Face(fallback->faces[i]);
+    fallback->paths[i]=DestroyString(fallback->paths[i]);
+  }
+  fallback->number_fonts=0;
+}
+
+static FT_UInt GetFallbackGlyph(FallbackInfo *fallback,const FT_ULong code,
+  FT_Face *face)
+{
+  size_t
+    i;
+
+  for (i=0; i < fallback->number_fonts; i++)
+  {
+    FT_UInt
+      index;
+
+    if (fallback->opened[i] == MagickFalse)
+      {
+        fallback->opened[i]=MagickTrue;
+        if (FT_New_Face(fallback->library,fallback->paths[i],0,
+              &fallback->faces[i]) != 0)
+          fallback->faces[i]=(FT_Face) NULL;
+        else
+          {
+            (void) FT_Select_Charmap(fallback->faces[i],FT_ENCODING_UNICODE);
+            if (FT_Set_Char_Size(fallback->faces[i],fallback->size,
+                  fallback->size,fallback->x_resolution,
+                  fallback->y_resolution) != 0)
+              {
+                (void) FT_Done_Face(fallback->faces[i]);
+                fallback->faces[i]=(FT_Face) NULL;
+              }
+          }
+      }
+    if (fallback->faces[i] == (FT_Face) NULL)
+      continue;
+    index=FT_Get_Char_Index(fallback->faces[i],code);
+    if (index != 0)
+      {
+        *face=fallback->faces[i];
+        return(index);
+      }
+  }
+  return(0);
+}
