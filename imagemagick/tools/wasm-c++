#!/usr/bin/env bash
# The add-on's C++ compiler for the guest (CXX of CMake and configure): clang-19 with wasm-cc's
# flags, C++ exceptions as WebAssembly exception handling (-fwasm-exceptions; the engine runs them,
# and wasm-cc rewrites the linked program to the standard exnref encoding), and libc++ (built by
# build.sh's deps stage with exceptions and libunwind, in build/wasm/deps). A link goes through
# tools/wasm-cc with libc++ and libc++abi (libunwind merged in) after the objects.
A="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
U="$(cd "$A/../../userspace" && pwd)"
D="${WASM_CXX_DEPS:-$A/build/wasm/deps}"
[[ $# == 1 && "$1" == -v ]] && exec "$U/bin/wasm-cc" -v
link=1
for a in "$@"; do case "$a" in -c|-S|-E|-M|-MM|-fsyntax-only) link=0 ;; esac; done
for a in "$@"; do case "$a" in -print-*|--version|-dumpmachine|-###) exec "$U/bin/wasm-cc" "$@" ;; esac; done
args=()
for a in "$@"; do case "$a" in -v|-Wl,-v) ;; *) args+=("$a") ;; esac; done
set -- "${args[@]}"
FLAGS=(--target=wasm32 -matomics -mbulk-memory -mllvm -wasm-enable-sjlj -fwasm-exceptions
       -D__linux__=1 -D__linux=1 -D__unix__=1 -D__unix=1 -D__gnu_linux__=1
       -Wno-unused-command-line-argument -Wno-override-module
       -nostdinc++ -isystem "$D/include/c++/v1" -isystem "$U/sysroot/include")
if [[ $link == 0 ]]; then
  exec clang++-19 "${FLAGS[@]}" "$@"
fi
# a link that names C++ sources: compile them first (wasm-cc's link would not find libc++'s headers)
srcs=0
for a in "$@"; do case "$a" in *.cc|*.cpp|*.cxx|*.C|*.c++) [[ -f "$a" ]] && srcs=1 ;; esac; done
if [[ $srcs == 1 ]]; then
  tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
  flags=() inputs=() n=0
  for ((i = 1; i <= $#; i++)); do
    a="${!i}"
    case "$a" in -o) i=$((i + 1)) ;; *.cc|*.cpp|*.cxx|*.C|*.c++|-l*|-L*|*.o|*.a|-Wl,*) ;; *) flags+=("$a") ;; esac
  done
  for ((i = 1; i <= $#; i++)); do
    a="${!i}"
    case "$a" in
      -o) i=$((i + 1)); inputs+=(-o "${!i}") ;;
      *.cc|*.cpp|*.cxx|*.C|*.c++) n=$((n + 1)); "$0" "${flags[@]}" -c "$a" -o "$tmp/$n.o" || exit; inputs+=("$tmp/$n.o") ;;
      *) inputs+=("$a") ;;
    esac
  done
  "$0" "${inputs[@]}"; exit
fi
exec "$A/tools/wasm-cc" "$@" "$D/lib/libc++.a" "$D/lib/libc++abi.a"
