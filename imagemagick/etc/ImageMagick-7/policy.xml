<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policymap [
  <!ELEMENT policymap (policy)*>
  <!ATTLIST policymap xmlns CDATA #FIXED "">
  <!ELEMENT policy EMPTY>
  <!ATTLIST policy xmlns CDATA #FIXED "" domain NMTOKEN #REQUIRED
    name NMTOKEN #IMPLIED pattern CDATA #IMPLIED rights NMTOKEN #IMPLIED
    stealth NMTOKEN #IMPLIED value CDATA #IMPLIED>
]>
<!--
  ImageMagick's security policy, as the imagemagick add-on of collaboCore sets it: the open
  policy (the guest is the sandbox; nothing in it is refused), with

  - resource limits for a WebAssembly program: it has at most 4 GiB of memory, for everything,
    so pixels beyond 2 GiB go to the pixel cache on disk (the guest's /tmp: the guest kernel's
    memory, not the program's); no memory mapping (there is no mmap in the guest)
  - fallback fonts: what a font has no glyph for (Hangul in DejaVu Sans) is drawn with the first
    of these that has it, a list of type.xml's font names or families, or font files ("none":
    none). -define type:fallback-font=... replaces the list for one command.

  `magick -list policy` and `magick -list resource` show what is in effect. See
  https://imagemagick.org/script/security-policy.php for the other policies.
-->
<policymap>
  <policy domain="resource" name="memory" value="2GiB"/>
  <policy domain="resource" name="map" value="0"/>
  <policy domain="system" name="fallback-font" value="NanumGothic,DejaVu Sans"/>
</policymap>
