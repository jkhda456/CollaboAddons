diff --git a/Modules/Platform/Linux.cmake b/Modules/Platform/Linux.cmake
index 5b61dd6b..96aa206b 100644
--- a/Modules/Platform/Linux.cmake
+++ b/Modules/Platform/Linux.cmake
@@ -67,3 +67,15 @@ if(NOT CMAKE_CROSSCOMPILING AND NOT CMAKE_COMPILER_SYSROOT)
     set_property(GLOBAL PROPERTY FIND_LIBRARY_USE_LIB64_PATHS FALSE)
   endif()
 endif()
+
+# collaboCore's wasm32 guest (uname -m: wasm): its programs and libraries are WebAssembly, which has
+# no run path — a program loads its libraries with dlopen, by path, and links to none of them — so
+# none is set, and nothing is relinked to change one at install (which the Ninja generator cannot
+# do but on ELF). A program that exports its symbols (ENABLE_EXPORTS: libraries it loads call into
+# it) is linked with the guest cc's -rdynamic, which exports the C library with them.
+if(CMAKE_SYSTEM_PROCESSOR STREQUAL "wasm")
+  set(CMAKE_SHARED_LIBRARY_RUNTIME_C_FLAG "")
+  set(CMAKE_SHARED_LIBRARY_RUNTIME_C_FLAG_SEP "")
+  set(CMAKE_SHARED_LIBRARY_RPATH_LINK_C_FLAG "")
+  set(CMAKE_EXE_EXPORTS_C_FLAG "-rdynamic")
+endif()
