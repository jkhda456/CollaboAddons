+ * macOS's extensions do below: posix_spawn_file_actions_addchdir_np, POSIX_SPAWN_SETSID, and a
+ * dup2 of a descriptor onto itself, which clears its close-on-exec flag (POSIX.1-2024) where
+ * macOS has posix_spawn_file_actions_addinherit_np. Without macOS's POSIX_SPAWN_CLOEXEC_DEFAULT,
+ * the spawn holds loop->cloexec_lock, as the fork does. */
+#if defined(__wasm__) && defined(__linux__)
+# define UV_USE_NOFORK_POSIX_SPAWN
+# include <limits.h>
+# include <paths.h>
+# include <spawn.h>
+#endif
+
+#if defined(UV_USE_APPLE_POSIX_SPAWN) || defined(UV_USE_NOFORK_POSIX_SPAWN)
+# define UV_USE_POSIX_SPAWN
+#endif
