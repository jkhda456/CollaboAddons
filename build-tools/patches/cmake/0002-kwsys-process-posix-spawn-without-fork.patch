+#if defined(KWSYSPE_USE_SPAWN)
+/* The child as kwsysProcessCreate's forked one sets it up: stdin, stdout and stderr (a
+   descriptor duplicated onto itself loses its close-on-exec flag, POSIX.1-2024, as the fork's
+   fcntl clears it), the default signal handlers, the signal mask from before the start, a new
+   session for CreateProcessGroup; not the read ends of the error and process group pipes (their
+   write ends are close-on-exec). A failed exec is posix_spawn's result. Not OptionDetach: that
+   takes an intermediate process, a second fork.  */
+static int kwsysProcessSpawn(kwsysProcess* cp, int prIndex,
+                             kwsysProcessCreateInformation* si,
+                             sigset_t const* mask, int const pgidPipe[2])
+{
+  posix_spawn_file_actions_t fa;
+  posix_spawnattr_t attr;
+  sigset_t all;
+  short flags = POSIX_SPAWN_SETSIGDEF | POSIX_SPAWN_SETSIGMASK;
+  pid_t pid;
+  int err;
+
+  if (cp->OptionDetach) {
+    return ENOSYS;
+  }
+  if ((err = posix_spawn_file_actions_init(&fa)) != 0) {
+    return err;
+  }
+  if ((err = posix_spawnattr_init(&attr)) != 0) {
+    posix_spawn_file_actions_destroy(&fa);
+    return err;
+  }
+  err = posix_spawn_file_actions_addclose(&fa, si->ErrorPipe[0]);
+  if (!err) {
+    err = posix_spawn_file_actions_addclose(&fa, pgidPipe[0]);
+  }
+  if (!err) {
+    err = si->StdIn >= 0 ? posix_spawn_file_actions_adddup2(&fa, si->StdIn, 0)
+                         : posix_spawn_file_actions_addclose(&fa, 0);
+  }
+  if (!err) {
+    err = posix_spawn_file_actions_adddup2(&fa, si->StdOut, 1);
+  }
+  if (!err) {
+    err = posix_spawn_file_actions_adddup2(&fa, si->StdErr, 2);
+  }
+  sigfillset(&all);
+  if (!err) {
+    err = posix_spawnattr_setsigdefault(&attr, &all);
+  }
+  if (!err) {
+    err = posix_spawnattr_setsigmask(&attr, mask);
+  }
+  if (cp->CreateProcessGroup) {
+    flags |= POSIX_SPAWN_SETSID;
+  }
+  if (!err) {
+    err = posix_spawnattr_setflags(&attr, flags);
+  }
+  if (!err) {
+    err = posix_spawnp(&pid, cp->Commands[prIndex][0], &fa, &attr,
+                       cp->Commands[prIndex], environ);
+  }
+  posix_spawnattr_destroy(&attr);
+  posix_spawn_file_actions_destroy(&fa);
+  if (!err) {
+    cp->ForkPIDs[prIndex] = pid;
+  }
+  return err;
+}
