+/* Safari's order of a ClientHello's extensions (the others after them, in OpenSSL's) */
+static const size_t safari_extension_order[] = {
+    TLSEXT_IDX_server_name, TLSEXT_IDX_extended_master_secret, TLSEXT_IDX_renegotiate,
+    TLSEXT_IDX_supported_groups, TLSEXT_IDX_ec_point_formats,
+    TLSEXT_IDX_application_layer_protocol_negotiation, TLSEXT_IDX_status_request,
+    TLSEXT_IDX_signature_algorithms, TLSEXT_IDX_signed_certificate_timestamp, TLSEXT_IDX_key_share,
+    TLSEXT_IDX_psk_kex_modes, TLSEXT_IDX_supported_versions, TLSEXT_IDX_compress_certificate
+};
+
+/*
+ * The order a ClientHello in Safari's shape constructs ext_defs in: Safari's, the rest, padding and
+ * psk last (psk must be). Returns the count; *grease_before: the place the last GREASE goes.
+ */
+static size_t safari_order(size_t *order, size_t *grease_before)
+{
+    size_t i, j, n = 0;
+
+    for (i = 0; i < OSSL_NELEM(safari_extension_order); i++)
+        order[n++] = safari_extension_order[i];
+    for (i = 0; i < OSSL_NELEM(ext_defs); i++) {
+        int listed = i == TLSEXT_IDX_padding || i == TLSEXT_IDX_psk;
+
+        for (j = 0; j < OSSL_NELEM(safari_extension_order) && !listed; j++)
+            listed = safari_extension_order[j] == i;
+        if (!listed)
+            order[n++] = i;
+    }
+    *grease_before = n;
+    order[n++] = TLSEXT_IDX_padding;
+    order[n++] = TLSEXT_IDX_psk;
+    return n;
+}
