The credentials of a proxy's address (http://USER:PASSWORD@HOST:PORT, as WebKit's proxy settings
and GSimpleProxyResolver give it): libsoup answered a 407 with them but then made the message's own
URI the proxy's (the request went to the proxy itself, a CONNECT tunnelled to it), and a wrong pair
was tried again up to 20 times; and the proxy's auth cached for one proxy was sent to the next
(the same host with new credentials kept the old). For `web proxy` (addons/wpe).

--- a/libsoup/auth/soup-auth-manager.c
+++ b/libsoup/auth/soup-auth-manager.c
@@ -178,6 +178,19 @@
 	return FALSE;
 }
 
+/* Another proxy, or the same with other credentials: what the last one
+ * took is not sent to it */
+static void
+proxy_resolver_changed (SoupSession *session, GParamSpec *pspec, SoupAuthManager *manager)
+{
+        SoupAuthManagerPrivate *priv = soup_auth_manager_get_instance_private (manager);
+
+        g_mutex_lock (&priv->mutex);
+        g_clear_object (&priv->proxy_auth);
+        g_clear_pointer (&priv->proxy_auth_authority, g_free);
+        g_mutex_unlock (&priv->mutex);
+}
+
 static void
 soup_auth_manager_attach (SoupSessionFeature *feature, SoupSession *session)
 {
@@ -185,6 +198,8 @@
 
 	/* FIXME: should support multiple sessions */
 	priv->session = session;
+        g_signal_connect_object (session, "notify::proxy-resolver",
+                                 G_CALLBACK (proxy_resolver_changed), feature, 0);
 }
 
