diff --git a/tls/openssl/gtlsclientconnection-openssl.c b/tls/openssl/gtlsclientconnection-openssl.c
index c60a881..0a9694e 100644
--- a/tls/openssl/gtlsclientconnection-openssl.c
+++ b/tls/openssl/gtlsclientconnection-openssl.c
@@ -371,6 +371,44 @@ handshake_thread_retrieve_certificate (SSL       *ssl,
   return 0;
 }
 
+/*
+ * The ClientHello of Safari 26 on macOS, which the browser (WPE WebKit, Safari's engine) presents
+ * itself as: its cipher suites in its order, its groups with key shares for X25519MLKEM768 and
+ * X25519, its signature algorithms, no session ticket or encrypt-then-mac extension, signed
+ * certificate timestamps and zlib-compressed certificates asked for; GREASE, its extensions' order
+ * and the rest of its shape from the add-on's OpenSSL (SSL_CTX_set_client_hello_safari). The
+ * G_TLS_OPENSSL_* variables below still have the last word; WPE_TLS_HELLO=openssl: OpenSSL's own.
+ */
+static void
+set_safari_client_hello (SSL_CTX *ctx)
+{
+  const gchar *hello = g_getenv ("WPE_TLS_HELLO");
+
+  if (hello && g_strcmp0 (hello, "safari") != 0)
+    return;
+  SSL_CTX_set_ciphersuites (ctx, "TLS_AES_128_GCM_SHA256:TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256");
+  SSL_CTX_set_cipher_list (ctx,
+                           "ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:"
+                           "ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-CHACHA20-POLY1305:"
+                           "ECDHE-ECDSA-AES256-SHA:ECDHE-ECDSA-AES128-SHA:ECDHE-RSA-AES256-SHA:ECDHE-RSA-AES128-SHA:"
+                           "AES256-GCM-SHA384:AES128-GCM-SHA256:AES256-SHA:AES128-SHA:"
+                           "ECDHE-ECDSA-DES-CBC3-SHA:ECDHE-RSA-DES-CBC3-SHA:DES-CBC3-SHA");
+  SSL_CTX_set1_groups_list (ctx, "*X25519MLKEM768:*X25519:P-256:P-384:P-521");
+  SSL_CTX_set1_sigalgs_list (ctx, "ECDSA+SHA256:rsa_pss_rsae_sha256:RSA+SHA256:ECDSA+SHA384:rsa_pss_rsae_sha384:"
+                                  "RSA+SHA384:rsa_pss_rsae_sha512:RSA+SHA512:RSA+SHA1");
+  SSL_CTX_set_options (ctx, SSL_OP_NO_TICKET | SSL_OP_NO_ENCRYPT_THEN_MAC);
+#ifndef OPENSSL_NO_CT
+  SSL_CTX_enable_ct (ctx, SSL_CT_VALIDATION_PERMISSIVE);
+#endif
+#ifdef TLSEXT_comp_cert_zlib
+  {
+    int compression[] = { TLSEXT_comp_cert_zlib };
+    SSL_CTX_set1_cert_comp_preference (ctx, compression, G_N_ELEMENTS (compression));
+  }
+#endif
+  SSL_CTX_set_client_hello_safari (ctx, 1);
+}
+
 static gboolean
 set_cipher_list (GTlsClientConnectionOpenssl  *client,
                  GError                      **error)
@@ -507,6 +545,8 @@ g_tls_client_connection_openssl_initable_init (GInitable       *initable,
       return FALSE;
     }
 
+  set_safari_client_hello (client->ssl_ctx);
+
   if (!set_cipher_list (client, error))
     return FALSE;
 
