+void WebSocketTask::collaboHandshakeDecided(RefPtr<JSON::Object>&& decision, GRefPtr<SoupSession>&& session)
+{
+    Ref protectedThis { *this };
+    if (g_cancellable_is_cancelled(m_cancellable.get()) || !m_handshakeMessage)
+        return;
+    String action = decision ? decision->getString("action"_s) : String();
+    if (action == "fail"_s) {
+        didFail(String { "WebSocket blocked by web intercept"_s });
+        return;
+    }
+    if (decision) {
+        String url = decision->getString("url"_s);
+        if (!url.isEmpty()) {
+            URL changed { url };
+            if (auto uri = WebCore::urlToSoupURI(changed)) {
+                soup_message_set_uri(m_handshakeMessage.get(), uri.get());
+                m_request.setURL(WTF::move(changed));
+            }
+        }
+        if (RefPtr headers = decision->getObject("headers"_s)) {
+            auto* soupHeaders = soup_message_get_request_headers(m_handshakeMessage.get());
+            soup_message_headers_clear(soupHeaders);
+            for (auto& entry : *headers) {
+                String value;
+                if (entry.value->asString(value))
+                    soup_message_headers_append(soupHeaders, entry.key.utf8().data(), value.utf8().data());
+            }
+            m_request.setHTTPHeaderFields(CollaboNet::headerMap(*headers));
+        }
+    }
+    connect(session.get());
+}
+
+// true: queued (behind what waits already, or to be held itself), delivered once decided
+bool WebSocketTask::collaboQueue(bool sent, SoupWebsocketDataType type, std::span<const uint8_t> data, CompletionHandler<void()>&& callback)
+{
+    uint64_t seq = ++m_collaboSeq[sent];
+    auto& queue = m_collaboQueue[sent];
+    if (queue.isEmpty() && !(CollaboNet::wants() & (sent ? CollaboNet::WebSocketSent : CollaboNet::WebSocketReceived)))
+        return false;
+    queue.append({ type, adoptGRef(g_bytes_new(data.data(), data.size())), WTF::move(callback), seq });
+    if (!m_collaboHolds[sent])
+        collaboNext(sent);
+    return true;
+}
+
+void WebSocketTask::collaboNext(bool sent)
+{
+    auto& queue = m_collaboQueue[sent];
+    while (!queue.isEmpty() && !m_collaboHolds[sent]) {
+        auto& message = queue.first();
+        if (CollaboNet::wants() & (sent ? CollaboNet::WebSocketSent : CollaboNet::WebSocketReceived)) {
+            auto event = collaboEvent("message"_s);
+            event->setString("direction"_s, sent ? "send"_s : "receive"_s);
+            event->setInteger("opcode"_s, message.type == SOUP_WEBSOCKET_DATA_TEXT ? 1 : 2);
+            event->setDouble("seq"_s, message.seq);
+            std::span bytes = span(message.data.get());
+            if (message.type == SOUP_WEBSOCKET_DATA_TEXT) {
+                event->setString("data"_s, String::fromUTF8(bytes));
+                event->setString("encoding"_s, "text"_s);
+            } else {
+                event->setString("data"_s, base64EncodeToString(bytes));
+                event->setString("encoding"_s, "base64"_s);
+            }
+            event->setDouble("size"_s, bytes.size());
+            m_collaboHolds[sent] = CollaboNet::hold(WTF::move(event), [this, sent](RefPtr<JSON::Object>&& decision) {
+                m_collaboHolds[sent] = 0;
+                collaboMessageDecided(sent, WTF::move(decision));
+            });
+            if (m_collaboHolds[sent])
+                return;
+        }
+        auto taken = queue.takeFirst();
+        collaboDeliver(sent, taken.type, taken.data.get());
+        if (taken.callback)
+            taken.callback();
+    }
+}
+
+void WebSocketTask::collaboMessageDecided(bool sent, RefPtr<JSON::Object>&& decision)
+{
+    Ref protectedThis { *this };
+    auto& queue = m_collaboQueue[sent];
+    if (queue.isEmpty())
+        return;
+    auto taken = queue.takeFirst();
+    String action = decision ? decision->getString("action"_s) : String();
+    if (action != "drop"_s && !g_cancellable_is_cancelled(m_cancellable.get())) {
+        GRefPtr<GBytes> data = taken.data;
+        auto type = taken.type;
+        String text;
+        if (decision && decision->getString("data"_s, text)) {
+            if (decision->getString("encoding"_s) == "base64"_s) {
+                if (auto bytes = base64Decode(text))
+                    data = adoptGRef(g_bytes_new(bytes->span().data(), bytes->size()));
+            } else {
+                auto utf8 = text.utf8();
+                data = adoptGRef(g_bytes_new(utf8.data(), utf8.length()));
+            }
+        }
+        if (auto opcode = decision ? decision->getInteger("opcode"_s) : std::nullopt)
+            type = *opcode == 2 ? SOUP_WEBSOCKET_DATA_BINARY : SOUP_WEBSOCKET_DATA_TEXT;
+        collaboDeliver(sent, type, data.get());
+    }
+    if (taken.callback)
+        taken.callback();
+    collaboNext(sent);
+}
+
+void WebSocketTask::collaboDeliver(bool sent, SoupWebsocketDataType type, GBytes* data)
+{
+    if (sent) {
+        if (m_connection && soup_websocket_connection_get_state(m_connection.get()) == SOUP_WEBSOCKET_STATE_OPEN)
+            soup_websocket_connection_send_message(m_connection.get(), type, data);
+        return;
+    }
+    RefPtr channel = m_channel.get();
+    if (!channel)
+        return;
+    std::span bytes = span(data);
+    if (type == SOUP_WEBSOCKET_DATA_TEXT)
+        channel->didReceiveText(String::fromUTF8(bytes));
+    else
+        channel->didReceiveBinaryData(bytes);
+}
+
+// it went away (closed, canceled): nothing of it is held any more, what waited is not delivered
+void WebSocketTask::collaboForget()
+{
+    CollaboNet::forget(m_collaboHandshakeHold);
+    for (bool sent : { false, true }) {
+        CollaboNet::forget(m_collaboHolds[sent]);
+        while (!m_collaboQueue[sent].isEmpty()) {
+            auto taken = m_collaboQueue[sent].takeFirst();
+            if (taken.callback)
+                taken.callback();
+        }
+    }
+}
+
 } // namespace WebKit
