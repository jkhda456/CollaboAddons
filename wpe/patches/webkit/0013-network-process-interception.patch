+// ── the wpe add-on's interception (CollaboNetIntercept.h) ────────────────────────────────────
+// A request waits before it goes (each hop of a redirect: m_currentRequest's redirect count), a
+// response before the client gets it, until the browser decides: go on (changed, for a request:
+// its address, method, headers, body), fail, or answer in its place (a response of the browser's,
+// read from memory). The page processes' own first hops are the inspector's (held in the page).
+
+static constexpr size_t collaboMaxBody = 32 * 1024 * 1024;
+
+Ref<JSON::Object> NetworkDataTaskSoup::collaboEvent(ASCIILiteral type)
+{
+    auto event = JSON::Object::create();
+    event->setString("type"_s, type);
+    event->setString("task"_s, CollaboNet::number(m_collaboTask));
+    event->setInteger("hop"_s, m_currentRequest.redirectCount());
+    if (RefPtr context = JSON::Value::parseJSON(m_collaboContext))
+        event->setValue("context"_s, context.releaseNonNull());
+    if (m_collaboByInspector)
+        event->setBoolean("byInspector"_s, true);
+    if (isTopLevelNavigation())
+        event->setBoolean("topLevel"_s, true);
+    return event;
+}
+
+void NetworkDataTaskSoup::collaboAddResponse(JSON::Object& event)
+{
+    event.setString("url"_s, m_response.url().string());
+    event.setInteger("status"_s, m_response.httpStatusCode());
+    event.setString("statusText"_s, m_response.httpStatusText());
+    event.setString("mimeType"_s, m_response.mimeType());
+    event.setString("httpVersion"_s, m_response.httpVersion());
+    event.setDouble("expectedLength"_s, m_response.expectedContentLength());
+    event.setObject("headers"_s, CollaboNet::headersObject(m_response.httpHeaderFields()));
+}
+
+bool NetworkDataTaskSoup::collaboHoldRequest()
+{
+    unsigned wants = CollaboNet::wants();
+    if (!(wants & CollaboNet::Request) || m_collaboPreflight)
+        return false;
+    unsigned hop = m_currentRequest.redirectCount();
+    if (!hop && m_collaboByInspector && (wants & CollaboNet::PageRequestsByInspector))
+        return false;
+
+    auto event = collaboEvent("request"_s);
+    event->setString("method"_s, String::fromUTF8(soup_message_get_method(m_soupMessage.get())));
+    event->setString("url"_s, m_currentRequest.url().string());
+    auto headers = m_currentRequest.httpHeaderFields();
+    if (!headers.contains(HTTPHeaderName::Accept))
+        headers.set(HTTPHeaderName::Accept, "*/*"_s);
+    event->setObject("headers"_s, CollaboNet::headersObject(headers));
+    bool fromFiles = false;
+    String body = CollaboNet::bodyBase64(m_currentRequest.httpBody(), fromFiles);
+    if (!body.isNull())
+        event->setString("body"_s, body);
+    if (fromFiles)
+        event->setBoolean("bodyFromFiles"_s, true);
+    if (hop && !m_response.isNull()) {
+        // the hop before: the redirect that brought it here
+        event->setString("redirectedFrom"_s, m_response.url().string());
+        event->setInteger("redirectStatus"_s, m_response.httpStatusCode());
+    }
+
+    stopTimeout();
+    m_collaboHold = CollaboNet::hold(WTF::move(event), [this](RefPtr<JSON::Object>&& decision) {
+        m_collaboHold = 0;
+        collaboRequestDecided(WTF::move(decision));
+    });
+    if (!m_collaboHold) {
+        startTimeout();
+        return false;
+    }
+    return true;
+}
+
+void NetworkDataTaskSoup::collaboRequestDecided(RefPtr<JSON::Object>&& decision)
+{
+    Ref protectedThis { *this };
+    if (m_state == State::Canceling || m_state == State::Completed || !m_client) {
+        clearRequest();
+        return;
+    }
+    String action = decision ? decision->getString("action"_s) : String();
+    if (action == "fail"_s) {
+        collaboFail(*decision);
+        return;
+    }
+    if (action == "respond"_s) {
+        collaboRespond(*decision, false);
+        return;
+    }
+    if (decision) {
+        ResourceRequest request = m_currentRequest;
+        bool changed = false;
+        String url = decision->getString("url"_s);
+        if (!url.isEmpty()) {
+            request.setURL(URL { url });
+            changed = true;
+        }
+        String method = decision->getString("method"_s);
+        if (!method.isEmpty()) {
+            request.setHTTPMethod(method);
+            changed = true;
+        }
+        if (RefPtr headers = decision->getObject("headers"_s)) {
+            request.setHTTPHeaderFields(CollaboNet::headerMap(*headers));
+            changed = true;
+        }
+        if (auto body = CollaboNet::bytes(*decision, "body"_s)) {
+            request.setHTTPBody(body->isEmpty() ? nullptr : RefPtr { FormData::create(body->span()) });
+            changed = true;
+        }
+        if (changed) {
+            // a new message for what goes now (nothing was sent of the old one)
+            if (m_soupMessage)
+                g_signal_handlers_disconnect_matched(m_soupMessage.get(), G_SIGNAL_MATCH_DATA, 0, 0, nullptr, nullptr, this);
+            m_soupMessage = nullptr;
+            createRequest(WTF::move(request), m_isBlockingCookies ? WasBlockingCookies::Yes : WasBlockingCookies::No);
+            if (!m_soupMessage)
+                return; // not an address that can be loaded: createRequest failed it
+        }
+    }
+    startTimeout();
+    sendRequest();
+}
+
+void NetworkDataTaskSoup::collaboFail(const JSON::Object& decision)
+{
+    String type = decision.getString("error"_s);
+    auto errorType = type == "AccessControl"_s ? ResourceError::Type::AccessControl
+        : type == "Cancellation"_s ? ResourceError::Type::Cancellation
+        : type == "Timeout"_s ? ResourceError::Type::Timeout : ResourceError::Type::General;
+    didFail(ResourceError(errorDomainWebKitInternal, 0, m_currentRequest.url(), "Blocked by web intercept"_s, errorType));
+}
+
+// a response of the browser's: before anything was sent (request stage) or in the place of the
+// one that came; its body from memory
+void NetworkDataTaskSoup::collaboRespond(const JSON::Object& decision, bool inPlaceOfResponse)
+{
+    auto body = CollaboNet::bytes(decision, "body"_s).value_or(Vector<uint8_t> { });
+    int status = decision.getInteger("status"_s).value_or(200);
+    String mimeType = decision.getString("mimeType"_s);
+    RefPtr headers = decision.getObject("headers"_s);
+    String contentType = headers ? headers->getString("Content-Type"_s) : String();
+    if (headers && contentType.isNull()) {
+        for (auto& entry : *headers) {
+            if (equalLettersIgnoringASCIICase(entry.key, "content-type"_s))
+                entry.value->asString(contentType);
+        }
+    }
+    if (mimeType.isEmpty())
+        mimeType = extractMIMETypeFromMediaType(contentType);
+    if (mimeType.isEmpty())
+        mimeType = "text/plain"_s;
+    // text without a charset is UTF-8 here (what the browser makes a body of)
+    String charset = extractCharsetFromMediaType(contentType).toString();
+    if (charset.isEmpty() && (mimeType.startsWith("text/"_s) || MIMETypeRegistry::isSupportedJSONMIMEType(mimeType) || mimeType.endsWith("+xml"_s) || mimeType == "image/svg+xml"_s))
+        charset = "UTF-8"_s;
+
+    ResourceResponse response(URL { m_currentRequest.url() }, String { mimeType }, body.size(), String { charset });
+    response.setHTTPStatusCode(status);
+    response.setHTTPStatusText(decision.getString("statusText"_s));
+    response.setHTTPVersion(inPlaceOfResponse && !m_response.httpVersion().isEmpty() ? String { m_response.httpVersion() } : String { "HTTP/1.1"_s });
+    // its headers, less what no longer holds for the body as it is given: an encoding, a length
+    HTTPHeaderMap headerMap = headers ? CollaboNet::headerMap(*headers) : HTTPHeaderMap { };
+    headerMap.remove(HTTPHeaderName::ContentEncoding);
+    headerMap.remove(HTTPHeaderName::TransferEncoding);
+    headerMap.set(HTTPHeaderName::ContentLength, String::number(body.size()));
+    response.setHTTPHeaderFields(WTF::move(headerMap));
+    if (inPlaceOfResponse)
+        response.setCertificateInfo(m_response.certificateInfo().value_or(CertificateInfo { }));
+    response.setSource(ResourceResponse::Source::InspectorOverride);
+
+    // what came is not read: the message's I/O ends (canceled, not closed: a close would read the
+    // rest of its body here, blocking)
+    if (m_inputStream && !m_collaboBody)
+        g_cancellable_cancel(m_cancellable.get());
+    m_cancellable = adoptGRef(g_cancellable_new());
+    m_multipartInputStream = nullptr;
+    m_response = WTF::move(response);
+    auto size = body.size();
+    m_inputStream = adoptGRef(g_memory_input_stream_new_from_data(g_memdup2(body.span().data(), size), size, g_free));
+    m_collaboAnswered = true;
+    m_collaboResponseDecided = true;
+    startTimeout();
+    dispatchDidReceiveResponse();
+}
+
+bool NetworkDataTaskSoup::collaboHoldResponse()
+{
+    if (std::exchange(m_collaboResponseDecided, false))
+        return false;
+    if (!m_soupMessage || !m_inputStream || m_multipartInputStream || isDownload() || m_collaboPreflight)
+        return false;
+    unsigned wants = CollaboNet::wants();
+    if (!(wants & (CollaboNet::Response | CollaboNet::ResponseBody)))
+        return false;
+    bool withBody = wants & CollaboNet::ResponseBody;
+    if (!withBody && m_collaboByInspector && (wants & CollaboNet::PageResponsesByInspector))
+        return false;
+
+    // first without the body: the browser says whether it wants it read (if it holds this one)
+    auto event = collaboEvent("response"_s);
+    collaboAddResponse(event.get());
+    event->setString("requestUrl"_s, m_currentRequest.url().string());
+    event->setString("method"_s, m_currentRequest.httpMethod());
+    if (withBody)
+        event->setBoolean("bodyAvailable"_s, true);
+    stopTimeout();
+    m_collaboHold = CollaboNet::hold(WTF::move(event), [this](RefPtr<JSON::Object>&& decision) {
+        m_collaboHold = 0;
+        collaboResponseDecided(WTF::move(decision));
+    });
+    if (!m_collaboHold) {
+        startTimeout();
+        return false;
+    }
+    return true;
+}
+
+void NetworkDataTaskSoup::collaboResponseDecided(RefPtr<JSON::Object>&& decision)
+{
+    Ref protectedThis { *this };
+    if (m_state == State::Canceling || m_state == State::Completed || !m_client) {
+        clearRequest();
+        return;
+    }
+    String action = decision ? decision->getString("action"_s) : String();
+    if (action == "body"_s) {
+        collaboReadBody();
+        return;
+    }
+    if (action == "fail"_s) {
+        collaboFail(*decision);
+        return;
+    }
+    if (action == "respond"_s) {
+        collaboRespond(*decision, true);
+        return;
+    }
+    m_collaboResponseDecided = true;
+    startTimeout();
+    dispatchDidReceiveResponse();
+}
+
+// the whole body into memory, then held again with it (the client reads it from there)
+void NetworkDataTaskSoup::collaboReadBody()
+{
+    if (m_collaboBody) {
+        collaboHoldResponseWithBody();
+        return;
+    }
+    if (m_response.expectedContentLength() > static_cast<long long>(collaboMaxBody)) {
+        collaboHoldResponseWithBody();
+        return;
+    }
+    GRefPtr<GOutputStream> output = adoptGRef(g_memory_output_stream_new_resizable());
+    startTimeout();
+    g_output_stream_splice_async(output.get(), m_inputStream.get(), static_cast<GOutputStreamSpliceFlags>(G_OUTPUT_STREAM_SPLICE_CLOSE_SOURCE | G_OUTPUT_STREAM_SPLICE_CLOSE_TARGET),
+        RunLoopSourcePriority::AsyncIONetwork, m_cancellable.get(), reinterpret_cast<GAsyncReadyCallback>(collaboReadBodyCallback), RefPtr { this }.leakRef());
+}
+
+void NetworkDataTaskSoup::collaboReadBodyCallback(GOutputStream* output, GAsyncResult* result, NetworkDataTaskSoup* task)
+{
+    RefPtr<NetworkDataTaskSoup> protectedThis = adoptRef(task);
+    GUniqueOutPtr<GError> error;
+    gssize read = g_output_stream_splice_finish(output, result, &error.outPtr());
+    if (task->m_state == State::Canceling || task->m_state == State::Completed || !task->m_client) {
+        task->clearRequest();
+        return;
+    }
+    if (read < 0) {
+        task->didFail(ResourceError::genericGError(task->m_currentRequest.url(), error.get()));
+        return;
+    }
+    task->m_collaboBytes += read;
+    task->m_collaboBody = adoptGRef(g_memory_output_stream_steal_as_bytes(G_MEMORY_OUTPUT_STREAM(output)));
+    task->m_inputStream = adoptGRef(g_memory_input_stream_new_from_bytes(task->m_collaboBody.get()));
+    task->collaboHoldResponseWithBody();
+}
+
+void NetworkDataTaskSoup::collaboHoldResponseWithBody()
+{
+    auto event = collaboEvent("response"_s);
+    collaboAddResponse(event.get());
+    event->setString("requestUrl"_s, m_currentRequest.url().string());
+    event->setString("method"_s, m_currentRequest.httpMethod());
+    if (m_collaboBody) {
+        gsize size = 0;
+        auto* data = static_cast<const uint8_t*>(g_bytes_get_data(m_collaboBody.get(), &size));
+        if (size <= collaboMaxBody)
+            event->setString("body"_s, base64EncodeToString(unsafeMakeSpan(data, size)));
+        else
+            event->setString("bodyOmitted"_s, makeString("larger than "_s, collaboMaxBody / 1024 / 1024, " MB"_s));
+        event->setDouble("bodySize"_s, size);
+    } else
+        event->setString("bodyOmitted"_s, makeString("larger than "_s, collaboMaxBody / 1024 / 1024, " MB"_s));
+    stopTimeout();
+    m_collaboHold = CollaboNet::hold(WTF::move(event), [this](RefPtr<JSON::Object>&& decision) {
+        m_collaboHold = 0;
+        if (decision && decision->getString("action"_s) == "body"_s)
+            decision->setString("action"_s, "continue"_s);
+        collaboResponseDecided(WTF::move(decision));
+    });
+    if (!m_collaboHold) {
+        m_collaboResponseDecided = true;
+        startTimeout();
+        dispatchDidReceiveResponse();
+    }
+}
+
+// what a service or shared worker loaded: how it ended
+void NetworkDataTaskSoup::collaboNoteDone(const ResourceError& error)
+{
+    if (!m_collaboRecord)
+        return;
+    auto event = collaboEvent("done"_s);
+    if (!error.isNull())
+        event->setString("error"_s, error.localizedDescription().isEmpty() ? "failed"_s : error.localizedDescription());
+    event->setDouble("bytes"_s, m_collaboBytes);
+    if (m_collaboAnswered)
+        event->setBoolean("answeredHere"_s, true);
+    CollaboNet::note(WTF::move(event));
+}
+
 } // namespace WebKit
 
