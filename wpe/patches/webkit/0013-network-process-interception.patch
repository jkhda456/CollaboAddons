+
+Ref<JSON::Object> WebSocketTask::collaboEvent(ASCIILiteral type)
+{
+    auto event = JSON::Object::create();
+    event->setString("type"_s, type);
+    event->setString("socket"_s, CollaboNet::number(m_collaboSocket));
+    event->setString("url"_s, m_request.url().string());
+    if (RefPtr context = JSON::Value::parseJSON(m_collaboContext))
+        event->setValue("context"_s, context.releaseNonNull());
+    return event;
