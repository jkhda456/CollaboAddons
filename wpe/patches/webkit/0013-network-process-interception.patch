diff --git a/Source/WebKit/NetworkProcess/CollaboNetIntercept.h b/Source/WebKit/NetworkProcess/CollaboNetIntercept.h
new file mode 100644
index 00000000..411f2fa3
--- /dev/null
+++ b/Source/WebKit/NetworkProcess/CollaboNetIntercept.h
@@ -0,0 +1,196 @@
+/*
+ * The network process's side of the browser's interception (the wpe add-on: `web intercept`).
+ *
+ * What the network process sends, receives and gives the page can be held here until the browser
+ * (the UI process) decides it: each HTTP request as it is about to go (every hop of a redirect,
+ * synchronous loads, pings and beacons, the requests of service and shared workers), each response
+ * before the page gets it (also with its whole body, to read and change), a WebSocket's handshake
+ * and its messages each way. The program links in the functions below (browser/netintercept.c: a
+ * socket to the browser); without them nothing is held. All of it runs on the main run loop.
+ *
+ *   collabo_net_wants()          what the browser wants held now (the bits of CollaboNet::Want)
+ *   collabo_net_hold(E, F, C)    E (a JSON object) goes to the browser; F(C, decision) is called
+ *                                once with its decision (a JSON object), or with null when the
+ *                                browser is gone (go on as it was). 0: not held (go on at once).
+ *   collabo_net_forget(ID)       what was held went away first (canceled): F is not called, its C
+ *                                is given back
+ *   collabo_net_note(E)          tells the browser something (recorded, nothing held)
+ */
+#pragma once
+
+#include "NetworkResourceLoadParameters.h"
+#include <WebCore/FetchOptionsDestination.h>
+#include <WebCore/FormData.h>
+#include <WebCore/HTTPHeaderMap.h>
+#include <wtf/Function.h>
+#include <wtf/JSONValues.h>
+#include <wtf/text/Base64.h>
+#include <wtf/text/WTFString.h>
+
+extern "C" {
+__attribute__((weak)) unsigned collabo_net_wants(void);
+__attribute__((weak)) unsigned long long collabo_net_hold(const char* event, void (*decided)(void* context, const char* decision), void* context);
+__attribute__((weak)) void* collabo_net_forget(unsigned long long id);
+__attribute__((weak)) void collabo_net_note(const char* event);
+}
+
+namespace WebKit::CollaboNet {
+
+enum Want : unsigned {
+    Request = 1 << 0,                // an HTTP request before it goes
+    Response = 1 << 1,               // a response before the page gets it
+    ResponseBody = 1 << 2,           // the same, with its body read first
+    WebSocketHandshake = 1 << 3,     // a WebSocket's opening handshake
+    WebSocketSent = 1 << 4,          // a WebSocket's messages the page sends
+    WebSocketReceived = 1 << 5,      // and those it receives
+    PageRequestsByInspector = 1 << 6, // the page processes' own loads (first hop) are held by the inspector
+    PageResponsesByInspector = 1 << 7,
+};
+
+inline unsigned wants()
+{
+    return collabo_net_wants ? collabo_net_wants() : 0;
+}
+
+using Decided = Function<void(RefPtr<JSON::Object>&&)>;
+
+inline void decidedTrampoline(void* context, const char* decision)
+{
+    std::unique_ptr<Decided> decided(static_cast<Decided*>(context));
+    RefPtr<JSON::Object> object;
+    if (decision) {
+        if (auto value = JSON::Value::parseJSON(String::fromUTF8(decision)))
+            object = value->asObject();
+        if (!object)
+            object = JSON::Object::create();
+    }
+    (*decided)(WTF::move(object));
+}
+
+// 0: not held (no browser to ask): go on
+inline uint64_t hold(Ref<JSON::Object>&& event, Decided&& decided)
+{
+    if (!collabo_net_hold)
+        return 0;
+    auto* context = new Decided(WTF::move(decided));
+    uint64_t id = collabo_net_hold(event->toJSONString().utf8().data(), decidedTrampoline, context);
+    if (!id)
+        delete context;
+    return id;
+}
+
+inline void forget(uint64_t& id)
+{
+    if (!id)
+        return;
+    uint64_t was = std::exchange(id, 0);
+    if (collabo_net_forget)
+        delete static_cast<Decided*>(collabo_net_forget(was));
+}
+
+inline void note(Ref<JSON::Object>&& event)
+{
+    if (collabo_net_note && wants())
+        collabo_net_note(event->toJSONString().utf8().data());
+}
+
+inline String number(uint64_t n)
+{
+    return String::number(n);
+}
+
+inline ASCIILiteral destinationName(WebCore::FetchOptionsDestination destination)
+{
+    static constexpr ASCIILiteral names[] = {
+        ""_s, "audio"_s, "audioworklet"_s, "document"_s, "embed"_s, "environmentmap"_s, "font"_s, "iframe"_s, "image"_s,
+        "json"_s, "manifest"_s, "model"_s, "object"_s, "paintworklet"_s, "report"_s, "script"_s, "serviceworker"_s,
+        "sharedworker"_s, "speculationrules"_s, "style"_s, "track"_s, "video"_s, "worker"_s, "xslt"_s,
+    };
+    auto index = static_cast<unsigned>(destination);
+    return index < std::size(names) ? names[index] : ""_s;
+}
+
+inline Ref<JSON::Object> headersObject(const WebCore::HTTPHeaderMap& headers)
+{
+    auto object = JSON::Object::create();
+    for (auto& header : headers)
+        object->setString(header.key, header.value);
+    return object;
+}
+
+// a body made of bytes only (not of files or blobs) as base64; null otherwise
+inline String bodyBase64(const WebCore::FormData* body, bool& fromFiles)
+{
+    fromFiles = false;
+    if (!body || body->isEmpty())
+        return { };
+    for (auto& element : body->elements()) {
+        if (!std::holds_alternative<Vector<uint8_t>>(element.data)) {
+            fromFiles = true;
+            return { };
+        }
+    }
+    return base64EncodeToString(body->flatten().span());
+}
+
+// a header map's lines from a decision's "headers" (an object of strings)
+inline WebCore::HTTPHeaderMap headerMap(const JSON::Object& headers)
+{
+    WebCore::HTTPHeaderMap map;
+    for (auto& entry : headers) {
+        String value;
+        if (entry.value->asString(value))
+            map.set(entry.key, value);
+    }
+    return map;
+}
+
+inline std::optional<Vector<uint8_t>> bytes(const JSON::Object& decision, const String& name)
+{
+    String text;
+    if (!decision.getString(name, text))
+        return std::nullopt;
+    return base64Decode(text);
+}
+
+// who loads a resource, for the browser: kind (load, sync, ping, preflight...), the page and
+// frame, the resource's identifier (the page's inspector names its request "0.<resource>"), the
+// worker (a service or shared worker's own process), the destination (document, script...)
+inline String context(ASCIILiteral kind, const NetworkResourceLoadParameters& parameters)
+{
+    auto object = JSON::Object::create();
+    object->setString("kind"_s, kind);
+    object->setString("page"_s, number(parameters.webPageID.toUInt64()));
+    object->setString("frame"_s, number(parameters.webFrameID.toUInt64()));
+    if (parameters.parentFrameID)
+        object->setString("parentFrame"_s, number(parameters.parentFrameID->toUInt64()));
+    if (parameters.identifier)
+        object->setString("resource"_s, number(parameters.identifier->toUInt64()));
+    object->setString("destination"_s, destinationName(parameters.options.destination));
+    if (parameters.options.keepAlive)
+        object->setBoolean("keepalive"_s, true);
+    if (parameters.isMainFrameNavigation)
+        object->setBoolean("mainFrame"_s, true);
+    if (parameters.isInitiatedByDedicatedWorker)
+        object->setString("worker"_s, "dedicated"_s);
+    WTF::switchOn(parameters.workerIdentifier,
+        [](const std::monostate&) { },
+        [&](const WebCore::SharedWorkerIdentifier& identifier) {
+            object->setString("worker"_s, "shared"_s);
+            object->setString("workerId"_s, number(identifier.toUInt64()));
+        },
+        [&](const WebCore::ServiceWorkerIdentifier& identifier) {
+            object->setString("worker"_s, "service"_s);
+            object->setString("workerId"_s, number(identifier.toUInt64()));
+        });
+    if (parameters.serviceWorkersMode != WebCore::ServiceWorkersMode::None && parameters.serviceWorkerRegistrationIdentifier)
+        object->setBoolean("serviceWorkerControlled"_s, true);
+    return object->toJSONString();
+}
+
+inline bool fromServiceOrSharedWorker(const NetworkResourceLoadParameters& parameters)
+{
+    return !std::holds_alternative<std::monostate>(parameters.workerIdentifier);
+}
+
+} // namespace WebKit::CollaboNet
