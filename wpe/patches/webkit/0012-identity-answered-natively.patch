 namespace WebCore {
 
+// Collabo: who the browser says it is, answered here in WebCore rather than by a script in the
+// page, so that what a page reads is native (getters, workers, CSS media queries alike). The
+// browser's web process extension sets it (addons/wpe browser/extension.c); unset, WebKit's own.
+struct CollaboIdentity {
+    Lock lock;
+    CString platform;
+    CString vendor;
+    int hardwareConcurrency { 0 };
+    int maxTouchPoints { -1 };
+    bool hasScreen { false };
+    int screen[7] { }; // width, height, availLeft, availTop, availWidth, availHeight, depth
+    bool hasWindow { false };
+    int window[4] { }; // screenX, screenY, outer width - view width, outer height - view height
+};
+
+static CollaboIdentity& collaboIdentity()
+{
+    static NeverDestroyed<CollaboIdentity> identity;
+    return identity;
+}
+
+String collaboNavigatorPlatform()
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    return identity.platform.isNull() ? String() : String::fromUTF8(identity.platform.span());
+}
+
+String collaboNavigatorVendor()
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    return identity.vendor.isNull() ? String() : String::fromUTF8(identity.vendor.span());
+}
+
+int collaboHardwareConcurrency()
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    return identity.hardwareConcurrency;
+}
+
+int collaboMaxTouchPoints()
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    return identity.maxTouchPoints;
+}
+
+bool collaboScreen(int values[7])
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    for (int i = 0; i < 7; i++)
+        values[i] = identity.screen[i];
+    return identity.hasScreen;
+}
+
+bool collaboWindow(int values[4])
+{
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    for (int i = 0; i < 4; i++)
+        values[i] = identity.window[i];
+    return identity.hasWindow;
+}
+
+static bool collaboNumbers(const char* text, int* values, int count)
+{
+    for (int i = 0; i < count; i++) {
+        char* end = nullptr;
+        long value = strtol(text, &end, 10);
+        if (end == text)
+            return false;
+        values[i] = static_cast<int>(value);
+        text = end;
+    }
+    return true;
+}
+
+} // namespace WebCore
+
+// KEY VALUE: "platform", "vendor", "hardwareConcurrency", "maxTouchPoints", "screen" ("W H AVAIL_LEFT
+// AVAIL_TOP AVAIL_W AVAIL_H DEPTH"), "window" ("X Y EXTRA_W EXTRA_H"), "timeZone" (an IANA name).
+// A null VALUE gives WebKit's own back, and so does an empty one but for the strings (Firefox's vendor
+// is ""). Any thread; returns false for what it cannot take.
+extern "C" bool webkit_collabo_identity_set(const char* key, const char* value)
+{
+    using namespace WebCore;
+    if (!key)
+        return false;
+    bool unset = !value || !*value;
+    if (!strcmp(key, "timeZone"))
+        return WTF::setHostTimeZoneForTesting(unset ? emptyString() : String::fromUTF8(value));
+    auto& identity = collaboIdentity();
+    Locker locker { identity.lock };
+    if (!strcmp(key, "platform"))
+        identity.platform = value ? CString(value) : CString();
+    else if (!strcmp(key, "vendor"))
+        identity.vendor = value ? CString(value) : CString();
+    else if (!strcmp(key, "hardwareConcurrency"))
+        identity.hardwareConcurrency = unset ? 0 : std::max(0, atoi(value));
+    else if (!strcmp(key, "maxTouchPoints"))
+        identity.maxTouchPoints = unset ? -1 : std::max(0, atoi(value));
+    else if (!strcmp(key, "screen")) {
+        int values[7];
+        if (!unset && !collaboNumbers(value, values, 7))
+            return false;
+        identity.hasScreen = !unset;
+        for (int i = 0; i < 7; i++)
+            identity.screen[i] = unset ? 0 : values[i];
+    } else if (!strcmp(key, "window")) {
+        int values[4];
+        if (!unset && !collaboNumbers(value, values, 4))
+            return false;
+        identity.hasWindow = !unset;
+        for (int i = 0; i < 4; i++)
+            identity.window[i] = unset ? 0 : values[i];
+    } else
+        return false;
+    return true;
+}
