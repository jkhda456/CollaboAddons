diff --git a/src/qemu/util/oslib-posix.c b/src/qemu/util/oslib-posix.c
index 3614205..3064527 100644
--- a/src/qemu/util/oslib-posix.c
+++ b/src/qemu/util/oslib-posix.c
@@ -99,6 +99,24 @@ void *qemu_memalign(size_t alignment, size_t size)
     return qemu_oom_check(qemu_try_memalign(alignment, size));
 }
 
+#if defined(__wasm__)
+/* WebAssembly: a program's memory is its own linear memory, which mmap does not hand out; a RAM
+   block comes from the heap, zeroed as an anonymous mapping is (qemu_anon_ram_free: free) */
+void *qemu_anon_ram_alloc(size_t size, uint64_t *alignment)
+{
+    size_t align = QEMU_VMALLOC_ALIGN;
+    void *ptr = qemu_try_memalign(align, size);
+
+    if (ptr == NULL) {
+        return NULL;
+    }
+    memset(ptr, 0, size);
+    if (alignment) {
+        *alignment = align;
+    }
+    return ptr;
+}
+#else
 /* alloc shared memory pages */
 void *qemu_anon_ram_alloc(size_t size, uint64_t *alignment)
 {
@@ -127,6 +145,7 @@ void *qemu_anon_ram_alloc(size_t size, uint64_t *alignment)
 
     return ptr;
 }
+#endif /* __wasm__ */
 
 void qemu_vfree(void *ptr)
 {
@@ -135,7 +154,11 @@ void qemu_vfree(void *ptr)
 
 void qemu_anon_ram_free(void *ptr, size_t size)
 {
+#if defined(__wasm__)
+    qemu_vfree(ptr);
+#else
     if (ptr) {
         munmap(ptr, size);
     }
+#endif
 }
