+#ifdef TCG_TARGET_INTERPRETER
+/*
+ * The type of a helper, for TCG's interpreter (tcg/tci.c, tci_call): a WebAssembly host checks
+ * the type of every call through a pointer, so the interpreter must call each helper as the
+ * type it has, not as one type for all (natively, the extra arguments go unnoticed). A helper's
+ * parameters and result are each a 32-bit or a 64-bit integer (pointers, softfloat's types,
+ * target_ulong), as its sizemask says; on a 32-bit host a 64-bit one takes two argument
+ * registers (and its result two output registers). Encoded as tci_call takes it: bits 0-1 the
+ * result (0 none, 1 32-bit, 2 64-bit), bits 2-4 the number of parameters, bit 5 + i the i-th
+ * parameter is 64-bit.
+ */
+static unsigned tci_call_sig(TCGContext *s, void *func, int nb_oargs, int nb_iargs)
+{
+    TCGHelperInfo *info = g_hash_table_lookup(s->helper_table, func);
+    unsigned sig, nargs = 0;
+    int slots = 0;
+
+    if (info == NULL) {
+        tcg_abort();
+    }
+    sig = nb_oargs == 0 ? 0 : (info->sizemask & 1) ? 2 : 1;
+    while (slots < nb_iargs) {
+        if (info->sizemask & (1 << (nargs + 1) * 2)) {
+            sig |= 1u << (5 + nargs);
+            slots += TCG_TARGET_REG_BITS == 32 ? 2 : 1;
+        } else {
+            slots += 1;
+        }
+        nargs++;
+    }
+    if (slots != nb_iargs || nargs > MAX_OPC_PARAM_IARGS) {
+        tcg_abort();
+    }
+    return sig | nargs << 2;
+}
+#endif
+
