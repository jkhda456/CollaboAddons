+            libc::clone(
+                child,
+                top,
+                libc::CLONE_VM | libc::CLONE_VFORK | libc::SIGCHLD,
+                &arg as *const Child<'_> as *mut c_void,
+            )
+        })?;
+        drop(stack);
+        Ok(pid)
