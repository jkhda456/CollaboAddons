-    fn export_symbols(&mut self, _tmpdir: &Path, _crate_type: CrateType, symbols: &[SymbolExport]) {
+    fn export_symbols(&mut self, _tmpdir: &Path, crate_type: CrateType, symbols: &[SymbolExport]) {
+        // (called before the libraries are added, set_output_kind after them)
+        if self.wasm_linux()
