--- /dev/null
+++ b/crates/typst-cli/src/guest.rs
@@ -0,0 +1,14 @@
+//! What the guest's libc lacks: collaboCore's guest is WebAssembly Linux without an MMU, so
+//! there is no `fork()`.
+//!
+//! std names `fork` on its process-spawning paths and the `open` crate (`--open`) on its own; in
+//! the guest a program starts with `posix_spawn` or not at all. This makes a stray fork an error
+//! (`ENOSYS`) instead of a link failure.
+
+#[cfg(all(target_arch = "wasm32", target_os = "linux"))]
+#[unsafe(no_mangle)]
+pub extern "C" fn fork() -> libc::pid_t {
+    // SAFETY: errno is this thread's own.
+    unsafe { *libc::__errno_location() = libc::ENOSYS };
+    -1
+}
